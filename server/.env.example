# Database (เช่น TiDB Cloud, Aiven, PlanetScale, Supabase)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=myapp_db
DB_PORT=3306

# Server
PORT=3000
JWT_KEY=your_secure_random_jwt_secret_key
FRONTEND_URL=https://your-frontend.vercel.app
BASE_URL=https://your-backend.onrender.com

# Email Configuration
# Option 1: Brevo HTTP API (Recommended for Railway/Render - Free 300 emails/day, no custom domain needed)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_email@gmail.com

# Option 2: Resend HTTP API (Requires Custom Domain or sending only to account email)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Option 3: Gmail SMTP (Requires SMTP ports 465/587 open)
EMAIL_USER=
EMAIL_PASS=
