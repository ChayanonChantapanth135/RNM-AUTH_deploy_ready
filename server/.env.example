# Database (เช่น TiDB Cloud Serverless, MySQL, Aiven)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=root
DB_PASSWORD=
DB_NAME=myapp_db
DB_PORT=4000
DB_SSL=true

# Server
PORT=3000
JWT_KEY=your_secure_random_jwt_secret_key
FRONTEND_URL=https://your-frontend.vercel.app
BASE_URL=https://your-backend.onrender.com

# Email Configuration
# Option 1: Brevo HTTP API (Recommended for Railway/Render - Free 300 emails/day, no custom domain needed)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_email@gmail.com

# Option 2: Resend HTTP API (Requires Custom Domain or sending only to account email)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=support@chayanonlab.link

# Option 3: Gmail SMTP (Requires SMTP ports 465/587 open)
EMAIL_USER=
EMAIL_PASS=

# Cloudinary Storage (Persistent profile pictures & task attachments)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
